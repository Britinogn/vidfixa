{
  "manifest_version": 3,
  "name": "VidFixa",
  "version": "0.1.0",
  "description": "Download the video on your current tab with VidFixa.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://vidfixa-api.onrender.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VidFixa",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
